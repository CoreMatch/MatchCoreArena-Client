# MatchCoreArena Client Environment Variables
#
# server_url precedence (highest first):
#   1. explicit config file: non-empty "server_url" in ~/.matchcorearena/config.json
#   2. MCA_SERVER_URL (this variable)
#   3. built-in default https://arena.mcnb.dev/
# The env var only applies when the config file does not explicitly set
# server_url (or the file is absent).

# Server URL (optional; overridden by an explicit config.json server_url)
# MCA_SERVER_URL=http://localhost:8080
